/*
 * arduino_secrets.h  (TEMPLATE)
 * -----------------------------
 * 1. Copy this file to `arduino_secrets.h` (same folder).
 * 2. Fill in your own Wi-Fi and Firebase credentials.
 * 3. `arduino_secrets.h` is git-ignored so your secrets never get committed.
 *
 * Notes:
 *  - ESP32 connects to 2.4 GHz Wi-Fi only (not 5 GHz).
 *  - Create the USER_EMAIL / USER_PASSWORD account under
 *    Firebase Console -> Authentication -> Email/Password.
 */

#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

// Wi-Fi (2.4 GHz)
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Firebase Web API Key (Project settings -> General)
#define API_KEY "YOUR_FIREBASE_API_KEY"

// Firebase Authentication user (Email/Password sign-in)
#define USER_EMAIL "you@example.com"
#define USER_PASSWORD "your-password"

// Realtime Database URL (include the trailing slash)
#define DATABASE_URL "https://YOUR_PROJECT-default-rtdb.REGION.firebasedatabase.app/"

#endif  // ARDUINO_SECRETS_H
